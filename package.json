{
  "name": "lupa-a11y",
  "displayName": "Lupa A11y",
  "description": "Linter de accesibilidad con explicaciones en español para React, Next.js, Vue, Svelte, Astro, Angular, Solid, Preact y HTML",
  "version": "1.2.0",
  "publisher": "AnderCMD",
  "icon": "assets/brand/icon-256.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnderCMD/Lupa-a11y.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Education"
  ],
  "keywords": [
    "accesibilidad",
    "a11y",
    "jsx",
    "react",
    "vue",
    "svelte",
    "astro",
    "angular",
    "html",
    "español",
    "wcag"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro",
    "onLanguage:html",
    "onLanguage:angular-html"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "En un workspace no confiable no se carga la configuración de ESLint del proyecto (es código ejecutable): se usa el preset incluido.",
      "restrictedConfigurations": [
        "lupaA11y.useProjectEslintConfig"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "En espacios de trabajo virtuales no se carga la configuración de ESLint del proyecto; se usa el preset incluido."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "lupaA11y.toggle",
        "title": "Alternar linting de accesibilidad",
        "category": "Lupa A11y"
      },
      {
        "command": "lupaA11y.showExplanation",
        "title": "Ver explicación de la regla",
        "category": "Lupa A11y"
      },
      {
        "command": "lupaA11y.analyzeWorkspace",
        "title": "Analizar todo el workspace",
        "category": "Lupa A11y"
      },
      {
        "command": "lupaA11y.clearWorkspaceResults",
        "title": "Limpiar resultados del análisis del workspace",
        "category": "Lupa A11y"
      },
      {
        "command": "lupaA11y.ignoreRule",
        "title": "Ignorar regla en este workspace",
        "category": "Lupa A11y"
      }
    ],
    "configuration": {
      "title": "Lupa A11y",
      "properties": {
        "lupaA11y.enable": {
          "type": "boolean",
          "default": true,
          "description": "Activa o desactiva Lupa A11y."
        },
        "lupaA11y.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "description": "Severidad con la que se muestran los problemas de accesibilidad."
        },
        "lupaA11y.ignoreRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Reglas a ignorar, por ejemplo \"jsx-a11y/alt-text\". Un id de jsx-a11y también ignora su equivalente en Vue y HTML (p. ej. \"vuejs-accessibility/alt-text\")."
        },
        "lupaA11y.lintOn": {
          "type": "string",
          "enum": [
            "type",
            "save"
          ],
          "default": "type",
          "description": "Cuándo analizar el archivo: mientras escribes o al guardar."
        },
        "lupaA11y.useProjectEslintConfig": {
          "type": "boolean",
          "default": true,
          "description": "Usa la configuración de ESLint del proyecto (eslint.config.*) si existe y configura reglas de accesibilidad para ese tipo de archivo (jsx-a11y, vuejs-accessibility o @html-eslint); solo se muestran esas reglas. Si no, o si el workspace no es de confianza, se usa el preset incluido."
        },
        "lupaA11y.criticalRulesAsError": {
          "type": "boolean",
          "default": false,
          "description": "Muestra como Error las reglas críticas (alt-text, aria-role, aria-props), sin importar la severidad por defecto."
        },
        "lupaA11y.maxFileSizeKb": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Tamaño máximo (en KB) de los archivos que se analizan; los más grandes se omiten."
        },
        "lupaA11y.languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "javascriptreact",
              "typescriptreact",
              "javascript",
              "vue",
              "svelte",
              "astro",
              "html",
              "angular-html"
            ]
          },
          "default": [
            "javascriptreact",
            "typescriptreact",
            "javascript",
            "vue",
            "svelte",
            "astro",
            "html",
            "angular-html"
          ],
          "description": "Idiomas del editor que se analizan. Quita \"javascript\" si no usas JSX en archivos .js, o \"html\" si no quieres analizar HTML."
        },
        "lupaA11y.workspaceMaxFiles": {
          "type": "number",
          "default": 2000,
          "minimum": 1,
          "description": "Máximo de archivos que analiza el comando \"Analizar todo el workspace\"."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "lupaA11y.showExplanation",
          "when": "false"
        },
        {
          "command": "lupaA11y.ignoreRule",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "build:brand": "tsx scripts/build-brand.ts",
    "check:translations": "tsx scripts/check-translations.ts",
    "bench": "tsx scripts/bench.ts",
    "test": "vitest run",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "vsce package --no-dependencies",
    "build:tests": "node esbuild.mjs --tests",
    "test:integration": "npm run build && npm run build:tests && tsx test/integration/runTest.ts",
    "build:lib": "tsx scripts/build-lib.ts",
    "smoke:lib": "node scripts/smoke-lib.mjs",
    "release:check": "tsx scripts/release.ts check",
    "release:prepare": "tsx scripts/release.ts prepare",
    "a11y": "tsx src/bin.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/inter": "^5.3.0",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "svgo": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.2"
  },
  "bugs": {
    "url": "https://github.com/AnderCMD/Lupa-a11y/issues"
  },
  "homepage": "https://github.com/AnderCMD/Lupa-a11y#readme",
  "private": true
}
